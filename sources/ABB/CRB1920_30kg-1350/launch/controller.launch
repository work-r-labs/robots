<launch>

<rosparam file="$(find CRB1920_30kg-1350)/launch/controller.yaml" command="load"/>
<node name="controller_spawner" pkg="controller_manager" type="spawner" respawn="false" output="screen" ns="CRB1920_30kg-1350_OmniCore_rev00_Assembly" args="Revolute 2_position_controller Revolute 3_position_controller Revolute 4_position_controller Revolute 5_position_controller Revolute 6_position_controller Revolute 7_position_controller joint_state_controller "/>
<node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" respawn="false" output="screen">
  <remap from="/joint_states" to="/CRB1920_30kg-1350_OmniCore_rev00_Assembly/joint_states"/>
</node>

</launch>